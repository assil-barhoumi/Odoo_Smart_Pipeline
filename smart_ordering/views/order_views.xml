<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="smart_order_list_view" model="ir.ui.view">
        <field name="name">smart.order.list</field>
        <field name="model">smart.order</field>
        <field name="arch" type="xml">
            <list string="Smart Orders">
                <field name="name"/>
                <field name="sender_email"/>
                <field name="source" widget="badge"
                    decoration-warning="source == 'gmail'"
                    decoration-info="source == 'outlook'"/>
                <field name="received_at"/>
                <field name="confidence" widget="percentage"
                    decoration-danger="confidence &lt; 0.3"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'pushed'"
                    decoration-warning="status in ('pending', 'extracted')"
                    decoration-danger="status == 'failed'"
                    decoration-muted="status == 'skipped'"/>
                <field name="sale_order_id" optional="show"/>
                <field name="recipient_email" string="Recipient" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="smart_order_kanban_view" model="ir.ui.view">
        <field name="name">smart.order.kanban</field>
        <field name="model">smart.order</field>
        <field name="arch" type="xml">
            <kanban class="o_sb_kanban" default_group_by="status" group_create="false" quick_create="false">
                <field name="status"/>
                <field name="confidence"/>
                <field name="source"/>
                <field name="received_at"/>
                <field name="sale_order_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-truncate" style="max-width:100%">
                                <field name="name"/>
                            </strong>
                        </div>
                        <div class="text-muted small text-truncate">
                            <i class="fa fa-envelope-o me-1" title="Sender"/>
                            <field name="sender_email"/>
                        </div>
                        <hr class="my-1"/>
                        <div class="d-flex justify-content-between small">
                            <span><i class="fa fa-calendar-o me-1" title="Date"/><field name="received_at"/></span>
                            <span t-attf-class="badge {{ record.source.raw_value == 'gmail' ? 'bg-warning text-dark' : 'bg-info text-white' }}">
                                <field name="source"/>
                            </span>
                        </div>
                        <div class="small mt-1">
                            Confidence:
                            <span t-attf-class="fw-bold {{ record.confidence.raw_value &lt; 0.7 ? 'text-danger' : 'text-success' }}">
                                <field name="confidence" widget="percentage"/>
                            </span>
                        </div>
                        <div t-if="record.sale_order_id.raw_value" class="mt-1 small">
                            <span class="badge text-white" style="background-color:#8e44ad;">Order #<field name="sale_order_id"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="smart_order_form_view" model="ir.ui.view">
        <field name="name">smart.order.form</field>
        <field name="model">smart.order</field>
        <field name="arch" type="xml">
            <form string="Smart Order">
                <header>
                    <button name="action_run_extraction" string="Run Extraction"
                        type="object" class="btn-primary" groups="sales_team.group_sale_salesman,base.group_system"
                        invisible="status not in ('pending', 'failed')"/>
                    <button name="action_push_to_erp" string="Push to ERP"
                        type="object" class="btn-primary" groups="sales_team.group_sale_salesman,base.group_system"
                        invisible="status != 'extracted'"/>
                    <button name="action_reset_to_pending" string="Reset to Pending"
                        type="object" groups="sales_team.group_sale_salesman,base.group_system"
                        invisible="status != 'failed'"/>
                    <field name="status" widget="statusbar"
                        statusbar_visible="pending,extracted,pushed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Email">
                            <field name="name" string="Subject"/>
                            <field name="sender_email"/>
                            <field name="recipient_email" string="Recipient"/>
                            <field name="source"/>
                            <field name="received_at"/>
                            <field name="message_id_short" string="Email Ref"/>
                            <field name="message_id" invisible="1"/>
                        </group>
                        <group string="Processing">
                            <field name="confidence_pct" widget="progressbar" string="Confidence"/>
                            <field name="suspected_multi_order" invisible="not suspected_multi_order"/>
                            <field name="sale_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Email Body">
                            <field name="email_body" widget="text" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Extracted Data">
                            <field name="extracted_json" widget="text" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Error" invisible="not error_message">
                            <field name="error_message" widget="text" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="smart_order_action" model="ir.actions.act_window">
        <field name="name">Smart Orders</field>
        <field name="res_model">smart.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{}</field>
    </record>

    <record id="smart_order_search_view" model="ir.ui.view">
        <field name="name">smart.order.search</field>
        <field name="model">smart.order</field>
        <field name="arch" type="xml">
            <search string="Smart Orders">
                <field name="name" string="Subject"/>
                <field name="sender_email" string="Sender"/>
                <field name="recipient_email" string="Recipient"/>
                <field name="message_id" string="Message-ID"/>
                <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <filter name="extracted" string="Extracted" domain="[('status', '=', 'extracted')]"/>
                <filter name="pushed" string="Pushed" domain="[('status', '=', 'pushed')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter name="low_confidence" string="Low Confidence" domain="[('confidence', '&lt;', 0.3)]"/>
                <separator/>
                <filter name="gmail" string="Gmail" domain="[('source', '=', 'gmail')]"/>
                <filter name="outlook" string="Outlook" domain="[('source', '=', 'outlook')]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                    <filter name="group_recipient" string="Recipient" context="{'group_by': 'recipient_email'}"/>
                    <filter name="group_message_id" string="Email" context="{'group_by': 'message_id_short'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="smart_ordering_menu_root"
        name="Smart Ordering"
        sequence="90"/>

    <menuitem id="smart_ordering_menu_orders"
        name="Orders"
        parent="smart_ordering_menu_root"
        action="smart_order_action"
        sequence="10"/>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="smart_invoice_line_form_view" model="ir.ui.view">
        <field name="name">smart.invoice.line.form</field>
        <field name="model">smart.invoice.line</field>
        <field name="arch" type="xml">
            <form string="Line Item">
                <sheet>
                    <group col="1">
                        <field name="description"/>
                    </group>
                    <group>
                        <field name="quantity"/>
                        <field name="unit_price"/>
                        <field name="total_line"/>
                        <field name="item_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="smart_invoice_search_view" model="ir.ui.view">
        <field name="name">smart.invoice.search</field>
        <field name="model">smart.invoice</field>
        <field name="arch" type="xml">
            <search string="Smart Invoices">
                <field name="supplier_name"/>
                <field name="invoice_number"/>
                <field name="recipient_email" string="Recipient"/>
                <field name="message_id" string="Message-ID"/>
                <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <filter name="extracted" string="Extracted" domain="[('status', '=', 'extracted')]"/>
                <filter name="validated" string="Validated" domain="[('status', '=', 'validated')]"/>
                <filter name="pushed" string="Pushed" domain="[('status', '=', 'pushed')]"/>
                <filter name="rejected" string="Rejected" domain="[('status', '=', 'rejected')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter name="low_confidence" string="Low Confidence" domain="[('confidence', '&lt;', 0.3)]"/>
                <separator/>
                <filter name="gmail" string="Gmail" domain="[('source', '=', 'gmail')]"/>
                <filter name="outlook" string="Outlook" domain="[('source', '=', 'outlook')]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_supplier" string="Supplier" context="{'group_by': 'supplier_name'}"/>
                    <filter name="group_recipient" string="Recipient" context="{'group_by': 'recipient_email'}"/>
                    <filter name="group_message_id" string="Email" context="{'group_by': 'message_id_short'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="smart_invoice_kanban_view" model="ir.ui.view">
        <field name="name">smart.invoice.kanban</field>
        <field name="model">smart.invoice</field>
        <field name="arch" type="xml">
            <kanban class="o_sb_kanban" default_group_by="status" group_create="false" quick_create="false">
                <field name="status"/>
                <field name="confidence"/>
                <field name="total_ttc"/>
                <field name="currency_code"/>
                <field name="invoice_date"/>
                <field name="move_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-truncate" style="max-width:100%">
                                <field name="invoice_number"/>
                            </strong>
                        </div>
                        <div class="text-muted small text-truncate">
                            <i class="fa fa-building-o me-1" title="Supplier"/>
                            <field name="supplier_name"/>
                        </div>
                        <hr class="my-1"/>
                        <div class="d-flex justify-content-between small">
                            <span><i class="fa fa-calendar-o me-1" title="Date"/><field name="invoice_date"/></span>
                            <strong><field name="total_ttc"/> <field name="currency_code"/></strong>
                        </div>
                        <div class="small mt-1">
                            Confidence:
                            <span t-attf-class="fw-bold {{ record.confidence.raw_value &lt; 0.7 ? 'text-danger' : 'text-success' }}">
                                <field name="confidence" widget="percentage"/>
                            </span>
                        </div>
                        <div t-if="record.move_id.raw_value" class="mt-1 small">
                            <span class="badge bg-info text-white">Bill #<field name="move_id"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="smart_invoice_list_view" model="ir.ui.view">
        <field name="name">smart.invoice.list</field>
        <field name="model">smart.invoice</field>
        <field name="arch" type="xml">
            <list>
                <field name="invoice_number"/>
                <field name="supplier_name"/>
                <field name="invoice_date"/>
                <field name="due_date" optional="hide"/>
                <field name="supplier_phone" optional="hide"/>
                <field name="supplier_tax_id" optional="hide"/>
                <field name="total_ttc"/>
                <field name="currency_code" string="Currency"/>
                <field name="confidence" widget="percentage"
                    decoration-danger="confidence &lt; 0.3"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'pushed'"
                    decoration-primary="status == 'validated'"
                    decoration-info="status == 'extracted'"
                    decoration-warning="status == 'pending'"
                    decoration-danger="status in ('rejected', 'failed')"/>
                <field name="file_name" optional="hide"/>
                <field name="recipient_email" string="Recipient" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="smart_invoice_form_view" model="ir.ui.view">
        <field name="name">smart.invoice.form</field>
        <field name="model">smart.invoice</field>
        <field name="arch" type="xml">
            <form string="Smart Invoice">
                <header>
                    <button name="action_run_extraction" string="Run Extraction" type="object"
                        class="btn-primary" groups="account.group_account_invoice,base.group_system" invisible="status != 'failed'"/>
                    <button name="action_reset_to_pending" string="Reset to Pending" type="object"
                        groups="account.group_account_invoice,base.group_system" invisible="status != 'failed'"/>
                    <button name="action_validate" string="Validate" type="object"
                        class="btn-primary" groups="account.group_account_invoice,base.group_system" invisible="status != 'extracted'"/>
                    <button name="action_update_supplier_info" string="Update Supplier Info" type="object"
                        class="btn-secondary" groups="account.group_account_invoice,base.group_system"
                        invisible="status != 'validated' or not supplier_info_changed"
                        confirm="This will overwrite the supplier's stored address and country with the values shown below. Continue?"/>
                    <button name="action_push" string="Push to Odoo" type="object"
                        class="btn-primary" groups="account.group_account_invoice,base.group_system" invisible="status != 'validated'"
                        confirm="This will create a vendor bill in Odoo. Continue?"/>
                    <button name="action_reject" string="Reject" type="object"
                        class="btn-danger" groups="account.group_account_invoice,base.group_system" invisible="status in ('pushed', 'rejected')"
                        confirm="Reject this invoice?"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,extracted,validated,pushed"/>
                </header>
                <sheet>
                    <group>
                        <field name="source"/>
                        <field name="sender_email"/>
                        <field name="recipient_email" string="Recipient"/>
                        <field name="received_at"/>
                        <field name="file_name"/>
                        <field name="message_id_short" string="Email Ref"/>
                        <field name="message_id" invisible="1"/>
                        <field name="confidence_pct" widget="progressbar" string="Confidence"/>
                        <field name="move_id" invisible="not move_id"/>
                    </group>

                    <field name="extracted_error" invisible="not extracted_error" widget="text"
                        class="text-danger"/>

                    <div invisible="status != 'pending'" class="alert alert-info" role="alert">
                        This invoice has been received but not yet extracted. Data will appear here once the extraction pipeline processes it.
                    </div>

                    <div invisible="status == 'pending'" class="o_sb_side_by_side">
                        <div class="o_sb_img_col">
                            <div class="o_sb_col_title">Invoice Preview</div>
                            <field name="invoice_file" widget="pdf_viewer" nolabel="1" invisible="not is_pdf"/>
                            <field name="invoice_file" widget="image" nolabel="1" invisible="is_pdf"/>
                        </div>
                        <div class="o_sb_fields_col">
                            <div class="o_sb_col_title">Invoice Details</div>
                            <group>
                                <field name="supplier_name" string="Supplier" invisible="not supplier_name"/>
                                <field name="supplier_street" string="Address" invisible="not supplier_street"/>
                                <field name="supplier_city" string="City" invisible="not supplier_city"/>
                                <field name="supplier_zip" string="Postal Code" invisible="not supplier_zip"/>
                                <field name="supplier_country" string="Country" invisible="not supplier_country"/>
                                <field name="supplier_phone" string="Phone" invisible="not supplier_phone"/>
                                <field name="supplier_tax_id" string="Tax ID" invisible="not supplier_tax_id"/>
                                <field name="supplier_bank_account" string="Bank Account" invisible="not supplier_bank_account or not bank_account_valid"/>
                                <field name="supplier_bank_name" string="Bank Name" invisible="not supplier_bank_account or not bank_account_valid"/>
                                <field name="invoice_number" string="Invoice #" invisible="not invoice_number"/>
                                <field name="invoice_date" string="Date" invisible="not invoice_date"/>
                                <field name="due_date" string="Due Date" invisible="not due_date"/>
                                <field name="currency_code" string="Currency" invisible="not currency_code"/>
                                <field name="total_ht" string="Total HT"/>
                                <field name="vat_amount" string="VAT"/>
                                <field name="total_ttc" string="Total TTC"/>
                                <field name="bank_account_valid" invisible="1"/>
                            </group>
                            <div invisible="status != 'validated' or not supplier_info_changed"
                                class="alert alert-info mt-2" role="alert">
                                <field name="supplier_info_diff" widget="text" nolabel="1"/>
                            </div>

                            <field name="has_missing_info" invisible="1"/>
                            <button name="action_toggle_additional_info" type="object"
                                string="Additional Info" class="btn-secondary mt-2"
                                invisible="not has_missing_info"/>

                            <div invisible="not show_additional_info" class="mt-2">
                                <group>
                                    <field name="supplier_name" string="Supplier" invisible="supplier_name"/>
                                    <field name="supplier_street" string="Address" invisible="supplier_street"/>
                                    <field name="supplier_city" string="City" invisible="supplier_city"/>
                                    <field name="supplier_zip" string="Postal Code" invisible="supplier_zip"/>
                                    <field name="supplier_country" string="Country" invisible="supplier_country"/>
                                    <field name="supplier_phone" string="Phone" invisible="supplier_phone"/>
                                    <field name="supplier_tax_id" string="Tax ID" invisible="supplier_tax_id"/>
                                    <field name="supplier_bank_account" string="Bank Account" invisible="supplier_bank_account and bank_account_valid"/>
                                    <field name="supplier_bank_name" string="Bank Name" invisible="supplier_bank_account and bank_account_valid"/>
                                    <field name="invoice_number" string="Invoice #" invisible="invoice_number"/>
                                    <field name="invoice_date" string="Date" invisible="invoice_date"/>
                                    <field name="due_date" string="Due Date" invisible="due_date"/>
                                    <field name="currency_code" string="Currency" invisible="currency_code"/>
                                </group>
                                <div invisible="not supplier_name or supplier_tax_id"
                                    class="alert alert-warning mt-2" role="alert">
                                    No tax ID (Matricule Fiscal / ICE / VAT number) was extracted for this supplier. Verify compliance before validating — reject if this invoice should have one.
                                </div>
                                <div invisible="not supplier_bank_account or bank_account_valid"
                                    class="alert alert-warning mt-2" role="alert">
                                    The extracted bank account doesn't look like a valid IBAN — verify it against the original document before validating.
                                </div>
                            </div>
                            <field name="line_ids" string="Line Items">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" string="Unit Price"/>
                                    <field name="total_line" string="Total"/>
                                    <field name="item_type" string="Type"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="smart_invoice_action" model="ir.actions.act_window">
        <field name="name">Smart Invoices</field>
        <field name="res_model">smart.invoice</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="smart_billing_menu_root"
        name="Smart Billing"
        sequence="90"/>

    <menuitem id="smart_billing_menu_invoices"
        name="Invoices"
        parent="smart_billing_menu_root"
        action="smart_invoice_action"
        sequence="10"/>

</odoo>
